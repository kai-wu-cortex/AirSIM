package main

import (
	"bytes"
	"encoding/json"
	"io"
	"net/http"
	"net/http/httptest"
	"os"
	"strings"
	"sync"
	"syscall"
	"testing"
	"time"
)

// This fixture is copied next to the exact 0.3.39 source by
// test_legacy_039_core_compat.py. It exercises the public HTTP contract while a
// socket pair behaves like the DATA11 AT channel; successful HTTP alone is not
// sufficient unless the expected modem commands and SMS payload are observed.
type legacy039FakeModem struct {
	file       *os.File
	mu         sync.Mutex
	commands   []string
	smsPayload []byte
	closed     chan struct{}
}

func newLegacy039Agent(t *testing.T) (*agent, *legacy039FakeModem) {
	t.Helper()
	fds, err := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_STREAM, 0)
	if err != nil {
		t.Fatal(err)
	}
	// DATA11 is opened O_NONBLOCK by the real Agent. Preserve that behavior or
	// harvestPendingURCs would block before the first command is written.
	if err := syscall.SetNonblock(fds[0], true); err != nil {
		t.Fatal(err)
	}
	service := newAgent("legacy-039-fake-at")
	service.at.file = os.NewFile(uintptr(fds[0]), "legacy-039-agent-at")
	modem := &legacy039FakeModem{
		file:   os.NewFile(uintptr(fds[1]), "legacy-039-modem-at"),
		closed: make(chan struct{}),
	}
	go modem.run()
	t.Cleanup(func() {
		_ = service.at.close()
		_ = modem.file.Close()
		select {
		case <-modem.closed:
		case <-time.After(time.Second):
			t.Error("fake modem did not stop")
		}
	})
	return service, modem
}

func (m *legacy039FakeModem) run() {
	defer close(m.closed)
	buffer := make([]byte, 0, 4096)
	temporary := make([]byte, 1024)
	waitingForSMS := false
	for {
		count, err := m.file.Read(temporary)
		if count > 0 {
			buffer = append(buffer, temporary[:count]...)
		}
		for {
			if waitingForSMS {
				end := bytes.IndexByte(buffer, 0x1a)
				if end < 0 {
					break
				}
				m.mu.Lock()
				m.smsPayload = append([]byte(nil), buffer[:end]...)
				m.mu.Unlock()
				buffer = buffer[end+1:]
				_, _ = io.WriteString(m.file, "\r\n+CMGS: 23\r\nOK\r\n")
				waitingForSMS = false
				continue
			}
			end := bytes.IndexByte(buffer, '\r')
			if end < 0 {
				break
			}
			command := strings.TrimSpace(string(buffer[:end]))
			buffer = buffer[end+1:]
			if command == "" {
				continue
			}
			m.mu.Lock()
			m.commands = append(m.commands, command)
			m.mu.Unlock()
			switch {
			case strings.HasPrefix(command, "AT+CMGS="):
				_, _ = io.WriteString(m.file, "\r\n> ")
				waitingForSMS = true
			case strings.HasPrefix(command, "AT+CMGR="):
				sender := encodeUCS2("+8613800138000")
				body := encodeUCS2("兼容短信 246810")
				_, _ = io.WriteString(m.file,
					"\r\n+CMGR: \"REC UNREAD\",\""+sender+"\",\"\",\"26/08/26,10:20:00+32\"\r\n"+
						body+"\r\nOK\r\n")
			default:
				_, _ = io.WriteString(m.file, "\r\nOK\r\n")
			}
		}
		if err != nil {
			return
		}
	}
}

func (m *legacy039FakeModem) snapshot() ([]string, []byte) {
	m.mu.Lock()
	defer m.mu.Unlock()
	return append([]string(nil), m.commands...), append([]byte(nil), m.smsPayload...)
}

func legacy039Request(
	t *testing.T,
	handler http.HandlerFunc,
	method string,
	path string,
	body string,
) *httptest.ResponseRecorder {
	t.Helper()
	request := httptest.NewRequest(method, path, strings.NewReader(body))
	request.Header.Set("Content-Type", "application/json")
	response := httptest.NewRecorder()
	handler(response, request)
	if response.Code < 200 || response.Code >= 300 {
		t.Fatalf("%s %s returned %d: %s", method, path, response.Code, response.Body.String())
	}
	return response
}

func TestCurrentAppCoreAPIWorksAgainstLegacy039(t *testing.T) {
	if agentVersion != "0.3.39" {
		t.Fatalf("fixture must run against Agent 0.3.39, got %s", agentVersion)
	}
	service, modem := newLegacy039Agent(t)

	legacy039Request(t, service.dial, http.MethodPost, "/api/calls/dial", `{"number":"+8613800138000"}`)
	legacy039Request(t, service.answer, http.MethodPost, "/api/calls/answer", `{}`)
	legacy039Request(t, service.hangup, http.MethodPost, "/api/calls/hangup", `{}`)

	service.mu.Lock()
	service.calls.Active = &callRecord{
		ID: "legacy-call", Index: 1, Direction: "incoming", State: "active",
		Number: "+8613800138000", StartedAt: time.Now(), UpdatedAt: time.Now(),
	}
	service.mu.Unlock()
	status := legacy039Request(t, service.callStatus, http.MethodGet, "/api/calls/status", "")
	if !strings.Contains(status.Body.String(), `"state":"active"`) ||
		!strings.Contains(status.Body.String(), `"direction":"incoming"`) {
		t.Fatalf("legacy call status is not current-App compatible: %s", status.Body.String())
	}

	sent := legacy039Request(t, service.smsSend, http.MethodPost, "/api/sms/send",
		`{"phone":"+8613800138000","message":"兼容发送 135790"}`)
	var sendResult struct {
		Sent     bool `json:"sent"`
		Segments int  `json:"segments"`
	}
	if err := json.Unmarshal(sent.Body.Bytes(), &sendResult); err != nil {
		t.Fatal(err)
	}
	if !sendResult.Sent || sendResult.Segments != 1 {
		t.Fatalf("unexpected legacy SMS send result: %+v", sendResult)
	}

	service.refreshStoredSMS(smsStorageRef{Memory: "SM", Index: 7})
	received := legacy039Request(t, service.smsList, http.MethodGet, "/api/sms", "")
	if !strings.Contains(received.Body.String(), "兼容短信 246810") ||
		!strings.Contains(received.Body.String(), `"code":"246810"`) {
		t.Fatalf("legacy received SMS is not current-App compatible: %s", received.Body.String())
	}

	commands, payload := modem.snapshot()
	joined := strings.Join(commands, "\n")
	for _, expected := range []string{
		"ATD+8613800138000;", "ATA", "ATH", "AT+CMGF=1", `AT+CSCS="UCS2"`,
		"AT+CSMP=17,167,0,8", "AT+CMGR=7",
	} {
		if !strings.Contains(joined, expected) {
			t.Errorf("missing modem command %q; commands:\n%s", expected, joined)
		}
	}
	if string(payload) != encodeUCS2("兼容发送 135790") {
		t.Errorf("unexpected SMS payload: %q", string(payload))
	}
}

func TestCurrentCleanupPackageIsAcceptedByLegacy039Verifier(t *testing.T) {
	if agentVersion != "0.3.39" {
		t.Fatalf("fixture must run against Agent 0.3.39, got %s", agentVersion)
	}
	packagePath := os.Getenv("DJONEHUB_LEGACY_CLEANUP_PACKAGE")
	if packagePath == "" {
		t.Fatal("DJONEHUB_LEGACY_CLEANUP_PACKAGE is required")
	}
	manifest, err := verifyModuleUpdateArchive(packagePath)
	if err != nil {
		t.Fatalf("legacy verifier rejected current cleanup package: %v", err)
	}
	expectedVersion := os.Getenv("DJONEHUB_EXPECTED_AGENT_VERSION")
	if expectedVersion == "" {
		t.Fatal("DJONEHUB_EXPECTED_AGENT_VERSION is required")
	}
	if manifest.Version != expectedVersion || manifest.Platform != moduleUpdatePlatform {
		t.Fatalf("unexpected cleanup manifest: %+v", manifest)
	}
	if len(manifest.Files) != len(moduleUpdateTargets) {
		t.Fatalf("cleanup payload count=%d, want %d", len(manifest.Files), len(moduleUpdateTargets))
	}
}
