#!/bin/sh
set -eu

token_file=/var/lib/airsim/control.token
if [ "$(id -u)" -ne 0 ]; then
    printf 'Run with sudo: sudo airsim-avf-pair\n' >&2
    exit 1
fi
if [ ! -s "$token_file" ]; then
    printf 'AirSIM pairing token is unavailable. Reinstall or repair airsim-avf-agent.\n' >&2
    exit 1
fi

guest_address='<AVF-guest-address>'
if command -v ip >/dev/null 2>&1; then
    default_interface=$(ip -4 route show default 2>/dev/null | awk '/^default / { print $5; exit }')
    if [ -n "$default_interface" ]; then
        discovered=$(ip -o -4 addr show dev "$default_interface" 2>/dev/null |
            awk '{ split($4, address, "/"); print address[1]; exit }')
        if [ -n "$discovered" ]; then
            guest_address=$discovered
        fi
    fi
fi

printf 'Agent endpoint:    http://%s:8575\n' "$guest_address"
printf 'Installer endpoint: http://%s:8576\n' "$guest_address"
printf 'Control token:     %s\n' "$(tr -d ' \r\n' < "$token_file")"
printf 'Enter the Agent endpoint and token once in the AirSIM Android app.\n'
