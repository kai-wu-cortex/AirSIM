# AirSIM AVF Agent defaults. Copy to /etc/airsim/agent.env before editing.
AIRSIM_RUNTIME_PROFILE=android-avf
AIRSIM_DATA_DIR=/var/lib/airsim
AIRSIM_ANDROID_CONTROL_TOKEN_FILE=/var/lib/airsim/control.token
AIRSIM_VOICE_BACKEND=samsung_android
# The host is replaced at runtime with the Android-side AVF gateway; the port is retained.
AIRSIM_SAMSUNG_PCM_ADDRESS=10.0.0.1:7580
