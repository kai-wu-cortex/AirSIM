      "html": "<div class=\"ds-row\"><div class=\"ds-row-main\"><div class=\"ds-network-title\">示例网络</div><div class=\"ds-network-detail\">已保存，可自动连接</div></div><div class=\"ds-row-actions\"><button class=\"ds-row-button\">连接</button><button class=\"ds-row-button ds-row-danger\">移除</button></div></div>",
      "css": ".ds-row{font:16px/1.55 -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;color:var(--ink,#17233b);padding:14px 0;border-top:1px solid var(--line,#d9e0eb);display:flex;align-items:center;justify-content:space-between;gap:12px}.ds-row-main{min-width:0;flex:1}.ds-network-title{font-weight:600;overflow-wrap:anywhere}.ds-network-detail{font-size:13px;color:var(--muted,#526077);margin-top:2px}.ds-row-actions{display:flex;align-items:center;gap:2px}.ds-row-button{font:16px/1.55 -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;min-height:48px;border:0;border-radius:8px;padding:10px 16px;cursor:pointer;font-weight:600;font-size:14px;padding:8px;min-height:44px;background:transparent;white-space:nowrap;color:var(--blue,#1659cc)}.ds-row-danger{color:var(--red,#a32525)}.ds-row-button:hover{background:transparent}.ds-row-button:focus-visible{outline:3px solid var(--blue,#1659cc);outline-offset:3px}.ds-row-button:active{transform:translateY(1px)}.ds-row-button:disabled{opacity:.55;cursor:wait}@media(max-width:380px){.ds-row-actions{flex-direction:column;gap:0}.ds-row-button{min-height:44px;padding:6px}}@media(prefers-reduced-motion:reduce){.ds-row-button:active{transform:none}}"
